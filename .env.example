# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=
# Optional. Defaults to "Erfan Zamani <SMTP_USER>"; Gmail only allows your own address or a verified alias.
MAIL_FROM=
# Where contact messages and résumé-request notifications go. Defaults to SMTP_USER.
MAIL_TO=

# Résumé attachment: put the file at private/resume.pdf locally (gitignored),
# or set a direct-download link here for production (e.g. a Vercel Blob URL).
RESUME_URL=
